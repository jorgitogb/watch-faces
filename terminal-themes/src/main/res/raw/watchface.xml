<?xml version="1.0" encoding="utf-8"?>
<!--
  Catppuccin: time (hours in text color, minutes in mauve), weather, date,
  step count, and a step-goal progress ring around the edge.

  Flavor palette slots, used as [CONFIGURATION.flavor.N]:
    0 base   1 surface0   2 text   3 subtext0
    4 mauve  5 peach      6 green  7 blue   8 yellow   9 overlay (dim)
  (slot names are Catppuccin's; other themes map their closest color.)
  Colors from https://catppuccin.com/palette
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <UserConfigurations>
        <ColorConfiguration id="flavor" displayName="flavor" defaultValue="0">
            <ColorOption id="0" displayName="flavor_mocha"
                colors="#FF1E1E2E #FF313244 #FFCDD6F4 #FFA6ADC8 #FFCBA6F7 #FFFAB387 #FFA6E3A1 #FF89B4FA #FFF9E2AF #FF6C7086" />
            <ColorOption id="1" displayName="flavor_macchiato"
                colors="#FF24273A #FF363A4F #FFCAD3F5 #FFA5ADCB #FFC6A0F6 #FFF5A97F #FFA6DA95 #FF8AADF4 #FFEED49F #FF6E738D" />
            <ColorOption id="2" displayName="flavor_frappe"
                colors="#FF303446 #FF414559 #FFC6D0F5 #FFA5ADCE #FFCA9EE6 #FFEF9F76 #FFA6D189 #FF8CAAEE #FFE5C890 #FF737994" />
            <ColorOption id="3" displayName="flavor_latte"
                colors="#FFEFF1F5 #FFCCD0DA #FF4C4F69 #FF6C6F85 #FF8839EF #FFFE640B #FF40A02B #FF1E66F5 #FFDF8E1D #FF9CA0B0" />
            <!-- Rosé Pine: minutes=rose, weather=gold, steps=foam, date=iris (https://rosepinetheme.com/palette) -->
            <ColorOption id="4" displayName="theme_rose_pine"
                colors="#FF191724 #FF26233A #FFE0DEF4 #FF908CAA #FFEBBCBA #FFF6C177 #FF9CCFD8 #FFC4A7E7 #FFF6C177 #FF6E6A86" />
            <ColorOption id="5" displayName="theme_rose_pine_moon"
                colors="#FF232136 #FF393552 #FFE0DEF4 #FF908CAA #FFEA9A97 #FFF6C177 #FF9CCFD8 #FFC4A7E7 #FFF6C177 #FF6E6A86" />
            <ColorOption id="6" displayName="theme_rose_pine_dawn"
                colors="#FFFAF4ED #FFDFDAD9 #FF575279 #FF797593 #FFD7827E #FFEA9D34 #FF56949F #FF907AA9 #FFEA9D34 #FF9893A5" />
            <!-- Night Owl: minutes=purple, weather=orange, steps=green, date=cyan -->
            <ColorOption id="7" displayName="theme_night_owl"
                colors="#FF011627 #FF1D3B53 #FFD6DEEB #FF82AAFF #FFC792EA #FFF78C6C #FFADDB67 #FF7FDBCA #FFECC48D #FF637777" />
        </ColorConfiguration>
        <ListConfiguration id="style" displayName="style" defaultValue="0">
            <ListOption id="0" displayName="style_classic" />
            <ListOption id="1" displayName="style_terminal" />
        </ListConfiguration>
        <BooleanConfiguration id="stars" displayName="stars" defaultValue="TRUE" />
    </UserConfigurations>

    <Scene backgroundColor="#FF000000">

        <!-- ============ Interactive (screen on) ============ -->
        <Group name="active" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <!-- Background -->
            <PartDraw x="0" y="0" width="450" height="450">
                <Rectangle x="0" y="0" width="450" height="450">
                    <Fill color="[CONFIGURATION.flavor.0]" />
                </Rectangle>
            </PartDraw>

            <!-- Starfield: white PNG layers tinted with the flavor palette.
                 Mid/near layers twinkle out of phase, driven by [SECOND]
                 (one update per second, so it stays cheap). -->
            <BooleanConfiguration id="stars">
                <BooleanOption id="TRUE">
                    <PartImage x="0" y="0" width="450" height="450"
                        tintColor="[CONFIGURATION.flavor.2]">
                        <Image resource="stars_far" />
                    </PartImage>
                    <PartImage x="0" y="0" width="450" height="450"
                        tintColor="[CONFIGURATION.flavor.4]">
                        <Transform target="alpha" value="170 + 85 * sin([SECOND] * 0.7)" />
                        <Image resource="stars_mid" />
                    </PartImage>
                    <PartImage x="0" y="0" width="450" height="450"
                        tintColor="[CONFIGURATION.flavor.8]">
                        <Transform target="alpha" value="170 + 85 * cos([SECOND] * 1.1)" />
                        <Image resource="stars_near" />
                    </PartImage>
                </BooleanOption>
            </BooleanConfiguration>

            <!-- Step-goal ring: track + progress -->
            <PartDraw x="0" y="0" width="450" height="450">
                <Arc centerX="225" centerY="225" width="426" height="426"
                    startAngle="0" endAngle="360">
                    <Stroke color="[CONFIGURATION.flavor.1]" thickness="10" />
                </Arc>
                <Arc centerX="225" centerY="225" width="426" height="426"
                    startAngle="0" endAngle="0">
                    <Transform target="endAngle"
                        value="clamp([STEP_PERCENT], 0, 100) * 3.6" />
                    <Stroke color="[CONFIGURATION.flavor.6]" thickness="10" cap="ROUND" />
                </Arc>
            </PartDraw>

            <ListConfiguration id="style">
            <!-- ================= Style 0: Classic ================= -->
            <ListOption id="0">

            <!-- Weather -->
            <Condition>
                <Expressions>
                    <Expression name="hasWeather"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
                </Expressions>
                <Compare expression="hasWeather">
                    <PartText x="75" y="78" width="300" height="46">
                        <Text align="CENTER">
                            <Font family="jetbrains_mono_bold" size="38"
                                color="[CONFIGURATION.flavor.5]">
                                <Template>%d°
                                    <Parameter expression="[WEATHER.TEMPERATURE]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                    <PartText x="75" y="124" width="300" height="30">
                        <Text align="CENTER" ellipsis="TRUE">
                            <Font family="jetbrains_mono_regular" size="22"
                                color="[CONFIGURATION.flavor.3]">
                                <Template>%s · %d°/%d°
                                    <Parameter expression="[WEATHER.CONDITION_NAME]" />
                                    <Parameter expression="[WEATHER.DAY_TEMPERATURE_HIGH]" />
                                    <Parameter expression="[WEATHER.DAY_TEMPERATURE_LOW]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                </Compare>
                <Default>
                    <PartText x="75" y="78" width="300" height="46">
                        <Text align="CENTER">
                            <Font family="jetbrains_mono_bold" size="38"
                                color="[CONFIGURATION.flavor.3]">--°</Font>
                        </Text>
                    </PartText>
                </Default>
            </Condition>

            <!-- Time: HH (text) : MM (mauve) -->
            <DigitalClock x="20" y="160" width="175" height="120">
                <TimeText format="hh" hourFormat="SYNC_TO_DEVICE" align="END"
                    x="0" y="0" width="175" height="120">
                    <Font family="jetbrains_mono_bold" size="110"
                        color="[CONFIGURATION.flavor.2]" />
                </TimeText>
            </DigitalClock>
            <PartText x="195" y="160" width="60" height="110">
                <Text align="CENTER">
                    <Font family="jetbrains_mono_bold" size="100"
                        color="[CONFIGURATION.flavor.3]">:</Font>
                </Text>
            </PartText>
            <DigitalClock x="255" y="160" width="175" height="120">
                <TimeText format="mm" align="START"
                    x="0" y="0" width="175" height="120">
                    <Font family="jetbrains_mono_bold" size="110"
                        color="[CONFIGURATION.flavor.4]" />
                </TimeText>
            </DigitalClock>

            <!-- Date, e.g. "Thu 5 Nov" -->
            <PartText x="75" y="284" width="300" height="38">
                <Text align="CENTER">
                    <Font family="jetbrains_mono_regular" size="28"
                        color="[CONFIGURATION.flavor.7]">
                        <Template>%s %d %s
                            <Parameter expression="[DAY_OF_WEEK_S]" />
                            <Parameter expression="[DAY]" />
                            <Parameter expression="[MONTH_S]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>

            <!-- Steps -->
            <PartText x="75" y="330" width="300" height="36">
                <Text align="CENTER">
                    <Font family="jetbrains_mono_regular" size="26"
                        color="[CONFIGURATION.flavor.6]">
                        <Template>%d steps
                            <Parameter expression="[STEP_COUNT]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
            </ListOption>

            <!-- ================= Style 1: Terminal =================
                 Mono font advance = 0.6 x size, so multi-color segments are
                 placed at computed x offsets (size 20 -> 12 px per char). -->
            <ListOption id="1">

                <!-- Prompt:  ○ brizuela@gw7 ~   (16 chars, x 129..321) -->
                <PartText x="129" y="56" width="30" height="28">
                    <Text align="START">
                        <Font family="jetbrains_mono_regular" size="20"
                            color="[CONFIGURATION.flavor.6]">○</Font>
                    </Text>
                </PartText>
                <PartText x="153" y="56" width="110" height="28">
                    <Text align="START">
                        <Font family="jetbrains_mono_bold" size="20"
                            color="[CONFIGURATION.flavor.2]">brizuela</Font>
                    </Text>
                </PartText>
                <PartText x="249" y="56" width="60" height="28">
                    <Text align="START">
                        <Font family="jetbrains_mono_regular" size="20"
                            color="[CONFIGURATION.flavor.3]">@gw7</Font>
                    </Text>
                </PartText>
                <PartText x="309" y="56" width="20" height="28">
                    <Text align="START">
                        <Font family="jetbrains_mono_bold" size="20"
                            color="[CONFIGURATION.flavor.7]">~</Font>
                    </Text>
                </PartText>

                <!-- Weather:  14° Cloudy ↑16 ↓8 -->
                <Condition>
                    <Expressions>
                        <Expression name="hasWeather"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
                    </Expressions>
                    <Compare expression="hasWeather">
                        <PartText x="60" y="90" width="110" height="32">
                            <Text align="END">
                                <Font family="jetbrains_mono_bold" size="22"
                                    color="[CONFIGURATION.flavor.5]">
                                    <Template>%d°
                                        <Parameter expression="[WEATHER.TEMPERATURE]" />
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="170" y="90" width="215" height="32">
                            <Text align="START" ellipsis="TRUE">
                                <Font family="jetbrains_mono_regular" size="22"
                                    color="[CONFIGURATION.flavor.3]">
                                    <Template> %s ↑%d ↓%d
                                        <Parameter expression="[WEATHER.CONDITION_NAME]" />
                                        <Parameter expression="[WEATHER.DAY_TEMPERATURE_HIGH]" />
                                        <Parameter expression="[WEATHER.DAY_TEMPERATURE_LOW]" />
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="75" y="90" width="300" height="32">
                            <Text align="CENTER">
                                <Font family="jetbrains_mono_regular" size="22"
                                    color="[CONFIGURATION.flavor.9]">--° no weather</Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>

                <!-- Time -->
                <DigitalClock x="20" y="150" width="175" height="120">
                    <TimeText format="hh" hourFormat="SYNC_TO_DEVICE" align="END"
                        x="0" y="0" width="175" height="120">
                        <Font family="jetbrains_mono_bold" size="104"
                            color="[CONFIGURATION.flavor.2]" />
                    </TimeText>
                </DigitalClock>
                <PartText x="195" y="150" width="60" height="110">
                    <Text align="CENTER">
                        <Font family="jetbrains_mono_bold" size="96"
                            color="[CONFIGURATION.flavor.9]">:</Font>
                    </Text>
                </PartText>
                <DigitalClock x="255" y="150" width="175" height="120">
                    <TimeText format="mm" align="START"
                        x="0" y="0" width="175" height="120">
                        <Font family="jetbrains_mono_bold" size="104"
                            color="[CONFIGURATION.flavor.4]" />
                    </TimeText>
                </DigitalClock>

                <!-- Left-aligned column like terminal output; prefixes at x=146 -->
                <!-- ≡ date -->
                <PartText x="146" y="270" width="30" height="30">
                    <Text align="START">
                        <Font family="jetbrains_mono_regular" size="22"
                            color="[CONFIGURATION.flavor.9]">≡</Font>
                    </Text>
                </PartText>
                <PartText x="172" y="270" width="190" height="30">
                    <Text align="START">
                        <Font family="jetbrains_mono_regular" size="22"
                            color="[CONFIGURATION.flavor.7]">
                            <Template>%s %d %s
                                <Parameter expression="[DAY_OF_WEEK_S]" />
                                <Parameter expression="[DAY]" />
                                <Parameter expression="[MONTH_S]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>

                <!-- » steps -->
                <PartText x="146" y="302" width="30" height="30">
                    <Text align="START">
                        <Font family="jetbrains_mono_regular" size="22"
                            color="[CONFIGURATION.flavor.9]">»</Font>
                    </Text>
                </PartText>
                <PartText x="172" y="302" width="190" height="30">
                    <Text align="START">
                        <Font family="jetbrains_mono_regular" size="22"
                            color="[CONFIGURATION.flavor.6]">
                            <Template>%d steps
                                <Parameter expression="[STEP_COUNT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>

                <!-- ❯ git push_  typed one char per second over a 14 s cycle:
                     t = [SECOND] % 14; t 0..8 types n = t chars, t 9..13 holds
                     the full command with a blinking cursor. Stays at 1 Hz. -->
                <PartText x="146" y="340" width="30" height="34">
                    <Text align="START">
                        <Font family="jetbrains_mono_bold" size="24"
                            color="[CONFIGURATION.flavor.6]">❯</Font>
                    </Text>
                </PartText>
                <PartText x="175" y="340" width="200" height="34">
                    <Text align="START">
                        <Font family="jetbrains_mono_regular" size="24"
                            color="[CONFIGURATION.flavor.3]">
                            <Template>%s
                                <Parameter expression="subText(&quot;git push&quot;, 0, ([SECOND] % 14 &gt; 8 ? 8 : [SECOND] % 14))" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
                <!-- Underscore cursor follows the text: JetBrains Mono advance is
                     0.6 em = 14.4 px at size 24. Solid while typing, blinks after. -->
                <PartText x="175" y="340" width="20" height="34">
                    <Transform target="x"
                        value="173 + 14.4 * ([SECOND] % 14 &gt; 8 ? 8 : [SECOND] % 14)" />
                    <Transform target="alpha"
                        value="[SECOND] % 14 &gt; 8 ? (1 - [SECOND] % 2) * 255 : 255" />
                    <Text align="START">
                        <Font family="jetbrains_mono_regular" size="24"
                            color="[CONFIGURATION.flavor.2]">_</Font>
                    </Text>
                </PartText>
            </ListOption>
            </ListConfiguration>
        </Group>

        <!-- ============ Always-on (ambient): black bg, time + date only ============ -->
        <Group name="ambient" x="0" y="0" width="450" height="450" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <DigitalClock x="25" y="160" width="400" height="120">
                <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                    x="0" y="0" width="400" height="120">
                    <Font family="jetbrains_mono_regular" size="110" color="#FFA6ADC8" />
                </TimeText>
            </DigitalClock>
            <PartText x="75" y="284" width="300" height="38">
                <Text align="CENTER">
                    <Font family="jetbrains_mono_regular" size="28" color="#FF6C7086">
                        <Template>%s %d %s
                            <Parameter expression="[DAY_OF_WEEK_S]" />
                            <Parameter expression="[DAY]" />
                            <Parameter expression="[MONTH_S]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
        </Group>
    </Scene>
</WatchFace>
